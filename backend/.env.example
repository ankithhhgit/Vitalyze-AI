# Copy to .env for local development and replace placeholders with your own values.
# Never commit .env or real credentials. This example uses local-only endpoints.

# MongoDB connection and database used by the API and Celery tasks.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=vitalyze_local

# Redis broker and result backend used by Celery.
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing configuration. Replace the placeholder with a random local key.
SECRET_KEY=replace-with-a-random-local-development-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp Cloud API configuration. These placeholders do not send messages.
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-local-webhook-verification-token
# Sending stays disabled unless explicitly enabled after credentials are configured.
WHATSAPP_SEND_ENABLED=false
# Each template must be approved by Meta. Leave blank until the exact approved
# name/language are verified. The code sends "medication_reminder_v3" for daily
# reminders and "refill_reminder_v1" for refill reminders, so set the matching
# values below only after those templates are approved.
WHATSAPP_APPROVED_TEMPLATE_NAME=
WHATSAPP_MEDICATION_TEMPLATE_NAME=
WHATSAPP_REFILL_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Meta app secret used to verify inbound webhook delivery-status signatures.
# Leave blank only for local development where no callbacks are expected.
WHATSAPP_APP_SECRET=

# Telegram Bot API configuration for reminder delivery. Create a bot with
# @BotFather and paste its token here. The token is backend-only: never expose
# it through EXPO_PUBLIC_* variables or commit it. No Telegram message is sent
# unless TELEGRAM_SEND_ENABLED is explicitly set to "true".
TELEGRAM_BOT_TOKEN=
# Bot username without the leading "@", used to build the t.me linking link.
TELEGRAM_BOT_USERNAME=
# Secret token passed to Telegram's setWebhook call so inbound updates can be
# authenticated (sent back as the X-Telegram-Bot-Api-Secret-Token header).
# Leave blank only for local development where no callbacks are expected.
TELEGRAM_WEBHOOK_SECRET=
# Explicit opt-in gate: reminders stay unsent until this is "true".
TELEGRAM_SEND_ENABLED=false
# Lifetime of a one-time account-linking code, in seconds.
TELEGRAM_LINK_CODE_TTL_SECONDS=900

# Geoapify Places API key used by pharmacy lookup. Leave blank to disable the
# pharmacy search locally. Backend-only: never expose it via EXPO_PUBLIC_* vars.
GEOAPIFY_API_KEY=

# Vertex AI project and location, plus path to a local service-account JSON file.
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./local-only-placeholder-service-account.json

# Gemini Developer API (Google AI Studio) key used by the chatbot and report AI
# interpretation. Create one in Google AI Studio and paste it here. The key is
# backend-only: never expose it through EXPO_PUBLIC_* variables or commit it.
GEMINI_API_KEY=
# Optional model override. Leave blank to use the default
# (gemini-3.5-flash-lite), which is free-tier supported and low latency.
# gemini-3.8-flash is also free-tier but is a reasoning model and much slower.
GEMINI_MODEL=gemini-3.5-flash-lite

# Report interpretation mode: "local" keeps extraction credential-free, "ai"
# enables Gemini report analysis (requires GEMINI_API_KEY above).
REPORT_ANALYSIS_MODE=local
