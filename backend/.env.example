# Copy to .env for local development and replace placeholders with your own values.
# Never commit .env or real credentials. This example uses local-only endpoints.

# MongoDB connection and database used by the API and Celery tasks.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=vitalyze_local

# Redis broker and result backend used by Celery.
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing configuration. Replace the placeholder with a random local key.
SECRET_KEY=replace-with-a-random-local-development-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp Cloud API configuration. These placeholders do not send messages.
WHATSAPP_API_VERSION=vXX.X
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-local-webhook-verification-token

# Google Maps Places API key used by pharmacy lookup. Leave blank to disable Maps locally.
GOOGLE_MAPS_API_KEY=

# Vertex AI project and location, plus path to a local service-account JSON file.
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./local-only-placeholder-service-account.json
